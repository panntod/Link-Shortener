# Connection string dari MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.b4ubtdc.mongodb.net/
# Nama database (opsional, default: shortener)
MONGODB_DB=shortener
# Token untuk masuk ke /dashboard. Buat yang panjang dan acak, contoh:
#   openssl rand -hex 24
ADMIN_TOKEN=ganti-dengan-token-acak-yang-panjang